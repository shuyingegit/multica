# SCS fork publish contract — used by scripts/redeploy-fork-fast.sh.
# Frontend host port 3005, backend host port 8088. Do not change casually:
# publishing to the wrong ports previously took down the live stack.
FRONTEND_PORT=3005
BACKEND_PORT=8088
PORT=8088
API_PORT=8088
SERVER_PORT=8088
FRONTEND_ORIGIN=http://localhost:3005
